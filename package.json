{
  "name": "owlbot-user-desktop",
  "productName": "Owl",
  "version": "0.1.0",
  "description": "Owl for the desktop: agents and workflows that run on this computer, on your organisation's Claude Code licence. No Owl server, no model API keys.",
  "main": "dist/main/main.js",
  "private": true,
  "author": "Nadeem Zaidi",
  "scripts": {
    "build:engine": "tsc -p tsconfig.json",
    "build:ui": "npm --prefix ui run build",
    "build": "npm run build:engine && npm run build:ui",
    "engine": "npm run build:engine && node dist/engine/standalone.js",
    "start": "npm run build && electron .",
    "test": "npm run build:engine && node --test --test-reporter=spec \"dist/tests/**/*.test.js\"",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.322",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "22.15.21",
    "typescript": "5.9.3",
    "electron": "44.5.1",
    "electron-builder": "26.17.0"
  }
}
